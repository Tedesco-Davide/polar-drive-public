<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="PolarDrive.Maui.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:PolarDrive.Maui.ViewModels"
    x:DataType="vm:LoginViewModel"
    Title="Accedi">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center">

            <Label
                Text="PolarDrive"
                FontSize="32"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="Accedi per gestire le tue pratiche"
                FontSize="14"
                TextColor="Gray"
                HorizontalOptions="Center"
                Margin="0,0,0,16" />

            <Label Text="Email" FontAttributes="Bold" />
            <Entry
                x:Name="EmailEntry"
                AutomationId="LoginEmailEntry"
                Placeholder="nome@azienda.it"
                Keyboard="Email"
                Text="{Binding Email}" />

            <Label Text="Password" FontAttributes="Bold" />
            <Entry
                x:Name="PasswordEntry"
                AutomationId="LoginPasswordEntry"
                Placeholder="Password"
                IsPassword="True"
                Text="{Binding Password}" />

            <Label
                AutomationId="LoginErrorLabel"
                Text="{Binding ErrorMessage}"
                TextColor="Red"
                IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <Button
                AutomationId="LoginButton"
                Text="Login"
                Command="{Binding LoginCommand}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                Margin="0,16,0,0" />

            <ActivityIndicator
                AutomationId="LoginBusyIndicator"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
