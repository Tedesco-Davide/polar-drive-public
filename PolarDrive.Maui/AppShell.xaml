<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PolarDrive.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:PolarDrive.Maui.Views"
    Title="PolarDrive.Maui"
    FlyoutBehavior="Disabled">

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage" />

    <ShellContent
        Title="Le mie pratiche"
        ContentTemplate="{DataTemplate views:PraticheListPage}"
        Route="PraticheListPage" />

</Shell>
