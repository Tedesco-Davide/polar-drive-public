<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PolarDrive.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:PolarDrive.Maui.Views"
    Title="PolarDrive.Maui"
    FlyoutBehavior="Disabled">

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage" />

    <!-- Il secondo ShellContent (PraticheListPage) viene aggiunto in
         AppShell.xaml.cs dopo InitializeComponent(): dichiararli entrambi qui
         fa scattare un bug di reentrancy in .NET MAUI (l'aggiunta del secondo
         item durante il CollectionChanged del primo lancia
         "Cannot change ObservableCollection during a CollectionChanged event"). -->

</Shell>
